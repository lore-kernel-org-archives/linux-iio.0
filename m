> >
> >       if (st->variant->flags & ADIS16400_HAS_SERIAL_NUMBER)
> > -             debugfs_create_file("serial_number", 0400,
> > +             debugfs_create_file_unsafe("serial_number", 0400,
> >                       indio_dev->debugfs_dentry, st,
> >                       &adis16400_serial_number_fops);
